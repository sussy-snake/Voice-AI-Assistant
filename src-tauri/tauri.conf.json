{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceAI",
  "version": "0.1.0",
  "identifier": "com.localvoice.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voice AI Assistant",
        "width": 520,
        "height": 780,
        "minWidth": 420,
        "minHeight": 580,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "alwaysOnTop": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "notification": {}
  }
}
